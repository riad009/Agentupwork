# ---------------------------------------------------------------------------
# Upwork AI Job Hunter — environment
#
# Copy to `.env` and fill in. Every value here is server-only; none of it is
# exposed to the browser except NEXT_PUBLIC_APP_URL.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
LOG_LEVEL="info"

# Disable self-service registration once your account exists.
ALLOW_REGISTRATION="true"

# --- Database --------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/upwork_ai_job_hunter?schema=public"

# --- Auth ------------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Encryption ------------------------------------------------------------
# 32 bytes as 64 hex characters: openssl rand -hex 32
# Encrypts Upwork tokens and every stored integration secret at rest.
# Rotating this makes existing stored secrets unreadable — reconnect after a rotation.
ENCRYPTION_KEY=""

# --- Queue -----------------------------------------------------------------
# Background runs use BullMQ. Without Redis the pipeline still runs, in-process.
REDIS_URL="redis://localhost:6379"
QUEUE_PREFIX="uajh"

# --- Claude (Anthropic) ----------------------------------------------------
# Platform fallback. Users can supply their own key under Settings → Claude AI.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
ANTHROPIC_ANALYSIS_MODEL="claude-haiku-4-5-20251001"
ANTHROPIC_DEMO_MODEL="claude-sonnet-5"

# --- Upwork (official API only) --------------------------------------------
# Register an application at https://www.upwork.com/developer/keys/apply
# "mock" uses built-in sample data and can never submit a proposal.
UPWORK_PROVIDER="mock"
UPWORK_CLIENT_ID=""
UPWORK_CLIENT_SECRET=""
UPWORK_REDIRECT_URI="http://localhost:3000/api/integrations/upwork/callback"
UPWORK_API_BASE_URL="https://api.upwork.com"
UPWORK_AUTH_BASE_URL="https://www.upwork.com"
UPWORK_WEBHOOK_SECRET=""

# --- GitHub ----------------------------------------------------------------
# Needs the `repo` scope so each demo can be published to its own repository.
GITHUB_TOKEN=""
GITHUB_OWNER=""
GITHUB_API_URL="https://api.github.com"

# --- Vercel ----------------------------------------------------------------
VERCEL_TOKEN=""
VERCEL_TEAM_ID=""
VERCEL_API_URL="https://api.vercel.com"
# Required before the deployment webhook endpoint will accept anything.
VERCEL_WEBHOOK_SECRET=""

# --- Email -----------------------------------------------------------------
# "console" logs messages instead of sending them.
EMAIL_PROVIDER="console"
EMAIL_FROM="Upwork AI Job Hunter <noreply@example.com>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# --- Error monitoring ------------------------------------------------------
# Optional. Any Sentry-compatible DSN; events are sent over the envelope API.
SENTRY_DSN=""

# --- Demo generation -------------------------------------------------------
DEMO_WORKSPACE_DIR="./demo-workspace"
STORAGE_DIR="./storage"
# Install + typecheck + build each demo locally before publishing it.
# Off by default: the Vercel build is authoritative and feeds the same repair loop.
DEMO_LOCAL_VALIDATION="false"
DEMO_VALIDATION_TIMEOUT_MS="300000"
# Screenshots and PDF rendering need Chromium. Leave blank to auto-detect.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=""

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="120"

# --- Seeding ---------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Admin"
