{
  "name": "upwork-ai-job-hunter",
  "version": "1.0.0",
  "private": true,
  "description": "AI-assisted Upwork job discovery, scoring, proposal generation and lightweight demo building SaaS.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "worker": "node --env-file-if-exists=.env --conditions=react-server --import tsx src/workers/main.ts",
    "worker:dev": "node --env-file-if-exists=.env --conditions=react-server --import tsx --watch src/workers/main.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-alert-dialog": "^1.1.20",
    "@radix-ui/react-avatar": "^1.1.13",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.20",
    "@radix-ui/react-progress": "^1.1.11",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.2.11",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.2.7",
    "@radix-ui/react-switch": "^1.2.11",
    "@radix-ui/react-tabs": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.11",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "ioredis": "^5.9.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "pino": "^10.3.1",
    "playwright": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.13",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
