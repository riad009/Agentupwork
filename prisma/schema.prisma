// Upwork AI Job Hunter — data model
// MongoDB + Prisma. Every domain document is scoped to a User so tenants stay isolated.
//
// MongoDB notes: ids are ObjectIds mapped to _id, monetary values are Float
// (the MongoDB connector has no Float type), and schema changes are applied
// with `prisma db push` rather than migrations.

generator client {
  provider = "prisma-client-js"
  // "native" covers local development; the RHEL target is what serverless
  // platforms (Vercel, AWS Lambda) actually run on.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum ScheduleFrequency {
  MANUAL
  HOURLY
  EVERY_3_HOURS
  EVERY_6_HOURS
  DAILY
}

enum ProjectType {
  FIXED
  HOURLY
  UNKNOWN
}

enum ExperienceLevel {
  ENTRY
  INTERMEDIATE
  EXPERT
  ANY
}

enum JobStatus {
  NEW
  ANALYZED
  SHORTLISTED
  PROPOSAL_READY
  SUBMITTED
  ARCHIVED
  SKIPPED
}

enum RecommendedAction {
  HIGH_PRIORITY
  APPLY
  WATCH
  SKIP
}

enum ProposalStatus {
  GENERATED
  NEEDS_REVIEW
  APPROVED
  REJECTED
  SAVED_FOR_LATER
  SUBMITTED
  FAILED
}

enum DemoComplexity {
  NONE
  SMALL
  MEDIUM
  LARGE
}

enum DemoStatus {
  NOT_REQUIRED
  PENDING
  PLANNING
  GENERATING
  VALIDATING
  REPO_CREATED
  DEPLOYING
  READY
  FAILED
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  READY
  ERROR
  CANCELED
}

enum DocumentStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum AutomationRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum AutomationTrigger {
  SCHEDULED
  MANUAL
  BACKFILL
}

enum RunLogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum SubmissionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum NotificationType {
  PROPOSALS_READY
  AUTOMATION_FAILED
  DEMO_READY
  SUBMISSION_RESULT
  SYSTEM
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum IntegrationProvider {
  UPWORK
  CLAUDE
  GITHUB
  VERCEL
  EMAIL
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  name          String?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  emailVerified DateTime?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  upworkConnection    UpworkConnection?
  preference          UserPreference?
  aiProfile           AiProfile?
  searchProfiles      JobSearchProfile[]
  jobs                Job[]
  analyses            JobAnalysis[]
  proposals           Proposal[]
  demos               DemoProject[]
  deployments         Deployment[]
  portfolio           PortfolioProject[]
  notifications       Notification[]
  automationRuns      AutomationRun[]
  submissions         Submission[]
  aiUsage             AiUsageRecord[]
  integrations        IntegrationCredential[]
  auditLogs           AuditLog[]

  @@index([role])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Integrations
// ---------------------------------------------------------------------------

/// OAuth2 connection to the official Upwork API. Tokens are AES-256-GCM
/// encrypted at rest and never leave the server.
model UpworkConnection {
  id                     String    @id @default(auto()) @map("_id") @db.ObjectId
  userId                 String    @unique @db.ObjectId
  upworkUserId           String?
  upworkOrgId            String?
  accessTokenCiphertext  String
  refreshTokenCiphertext String?
  scope                  String?
  tokenType              String    @default("Bearer")
  expiresAt              DateTime?
  connectedAt            DateTime  @default(now())
  lastSyncedAt           DateTime?
  lastRefreshedAt        DateTime?
  isActive               Boolean   @default(true)
  profileTitle           String?
  profileName            String?
  profilePictureUrl      String?
  countryCode            String?
  connectsBalance        Int?
  connectsUpdatedAt      DateTime?
  rawProfile             Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

/// Per-user credentials for replaceable providers (Claude, GitHub, Vercel, SMTP).
/// `secretCiphertext` is encrypted; only the server ever decrypts it.
model IntegrationCredential {
  id               String              @id @default(auto()) @map("_id") @db.ObjectId
  userId           String              @db.ObjectId
  provider         IntegrationProvider
  label            String?
  secretCiphertext String
  metadata         Json?
  lastVerifiedAt   DateTime?
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([provider])
}

// ---------------------------------------------------------------------------
// Preferences
// ---------------------------------------------------------------------------

model UserPreference {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId

  // automation
  automationEnabled Boolean           @default(false)
  scheduleFrequency ScheduleFrequency @default(MANUAL)
  maxJobsPerRun     Int               @default(100)
  topJobsCount      Int               @default(10)

  // demo / cost protection thresholds
  demoAutoThreshold     Int     @default(90)
  demoSuggestThreshold  Int     @default(80)
  proposalOnlyThreshold Int     @default(70)
  demoValueScoreMinimum Int     @default(80)
  maxDemosPerRun        Int     @default(3)
  maxDemoPages          Int     @default(7)
  maxDemoIterations     Int     @default(3)
  maxBuildFixAttempts   Int     @default(3)
  maxScreenshots        Int     @default(6)
  generatePdf           Boolean @default(true)
  demoGenerationEnabled Boolean @default(true)

  // ranking weights (0-100, normalised at scoring time)
  weightSkillMatch    Int @default(25)
  weightClientQuality Int @default(15)
  weightBudget        Int @default(15)
  weightCompetition   Int @default(15)
  weightWinProb       Int @default(20)
  weightRecency       Int @default(10)

  // notifications
  emailNotifications      Boolean @default(true)
  notifyOnProposalsReady  Boolean @default(true)
  notifyOnAutomationError Boolean @default(true)
  notifyOnSubmission      Boolean @default(true)
  digestOnly              Boolean @default(false)

  // proposal preferences
  proposalTone     String  @default("direct, warm, technically specific")
  proposalMaxWords Int     @default(220)
  includeQuestions Boolean @default(true)
  signatureName    String?
  portfolioUrl     String?
  companyName      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Freelancer context injected into every Claude prompt.
model AiProfile {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                String   @unique @db.ObjectId
  professionalTitle     String?
  yearsOfExperience     Int?
  hourlyRate            Float?
  minimumBudget         Float?
  preferredProjectSize  String?
  preferredTechnologies String[] @default([])
  industries            String[] @default([])
  availability          String?
  preferredTone         String?
  proposalLength        String   @default("SHORT")
  countriesToAvoid      String[] @default([])
  bio                   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobSearchProfile {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  userId   String  @db.ObjectId
  name     String
  isActive Boolean @default(true)

  keywords        String[] @default([])
  includeKeywords String[] @default([])
  excludeKeywords String[] @default([])
  skills          String[] @default([])
  categoryIds     String[] @default([])

  minFixedBudget      Float?
  minHourlyRate       Float?
  maxHourlyRate       Float?
  maxJobAgeHours      Int?              @default(72)
  minClientHireRate   Int?
  minClientSpend      Float?
  paymentVerifiedOnly Boolean           @default(true)
  minClientRating     Float?
  maxProposals        Int?
  countries           String[]          @default([])
  excludedCountries   String[]          @default([])
  experienceLevels    ExperienceLevel[] @default([])
  projectType         ProjectType       @default(UNKNOWN)
  durations           String[]          @default([])
  resultLimit         Int               @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]

  @@unique([userId, name])
  @@index([userId, isActive])
}

// ---------------------------------------------------------------------------
// Jobs
// ---------------------------------------------------------------------------

model Job {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  userId          String  @db.ObjectId
  searchProfileId String? @db.ObjectId

  upworkJobId String
  title       String
  description String
  url         String
  category    String?
  subcategory String?
  skills      String[] @default([])

  projectType       ProjectType     @default(UNKNOWN)
  experienceLevel   ExperienceLevel @default(ANY)
  budgetAmount      Float?
  hourlyMin         Float?
  hourlyMax         Float?
  currency          String          @default("USD")
  estimatedDuration String?
  workload          String?
  connectsRequired  Int?

  clientCountry         String?
  clientCity            String?
  clientRating          Float?
  clientHireRate        Int?
  clientTotalSpent      Float?
  clientJobsPosted      Int?
  clientTotalHires      Int?
  clientOpenJobs        Int?
  clientPaymentVerified Boolean   @default(false)
  clientMemberSince     DateTime?

  proposalsCount    Int?
  proposalsRange    String?
  interviewCount    Int?
  invitesSent       Int?
  unansweredInvites Int?

  postedAt  DateTime
  fetchedAt DateTime  @default(now())
  status    JobStatus @default(NEW)
  raw       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  searchProfile JobSearchProfile?  @relation(fields: [searchProfileId], references: [id], onDelete: SetNull)
  analysis      JobAnalysis?
  proposals     Proposal[]
  demos         DemoProject[]
  submissions   Submission[]
  runJobs       AutomationRunJob[]

  @@unique([userId, upworkJobId])
  @@index([userId, status])
  @@index([userId, postedAt])
  @@index([userId, fetchedAt])
  @@index([searchProfileId])
  @@index([upworkJobId])
}

model JobAnalysis {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  jobId  String @unique @db.ObjectId
  userId String @db.ObjectId

  overallScore       Int
  skillMatch         Int
  clientQuality      Int
  competitionScore   Int
  budgetScore        Int
  winningProbability Int
  riskScore          Int
  rankedScore        Float @default(0)

  recommendedAction    RecommendedAction
  reasoningSummary     String
  strengths            String[]          @default([])
  risks                String[]          @default([])
  technicalOpportunity String?

  demoRecommended  Boolean        @default(false)
  demoReason       String?
  demoComplexity   DemoComplexity @default(NONE)
  estimatedFiles   Int?
  demoRequirements String[]       @default([])
  demoValueScore   Int            @default(0)

  requirementsExtract Json?
  model               String?
  inputTokens         Int?
  outputTokens        Int?
  analysisVersion     String   @default("1")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, overallScore])
  @@index([userId, recommendedAction])
  @@index([userId, rankedScore])
}

// ---------------------------------------------------------------------------
// Proposals / demos / deployments
// ---------------------------------------------------------------------------

model Proposal {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  jobId  String @db.ObjectId

  status           ProposalStatus @default(GENERATED)
  content          String
  editedContent    String?
  questions        String[]       @default([])
  bidAmount        Float?
  bidHourlyRate    Float?
  connectsRequired Int?
  demoUrlIncluded  Boolean        @default(false)
  version          Int            @default(1)

  model        String?
  inputTokens  Int?
  outputTokens Int?

  approvedAt    DateTime?
  rejectedAt    DateTime?
  submittedAt   DateTime?
  reviewNotes   String?
  failureReason String?

  /// Stable key that makes Upwork submission idempotent.
  idempotencyKey String @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  job          Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  demo         DemoProject?
  document     ProposalDocument?
  submissions  Submission[]
  runProposals AutomationRunProposal[]

  @@index([userId, status])
  @@index([jobId])
  @@index([userId, createdAt])
}

model DemoProject {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  userId     String  @db.ObjectId
  jobId      String  @db.ObjectId
  proposalId String? @unique @db.ObjectId

  status        DemoStatus     @default(PENDING)
  complexity    DemoComplexity @default(SMALL)
  templateKey   String?
  title         String
  summary       String?
  industry      String?
  plan          Json?
  coverage      Json?
  requirements  Json?
  demoEmail     String?
  demoPassword  String?
  pageCount     Int            @default(0)
  fileCount     Int            @default(0)
  iterations    Int            @default(0)
  buildAttempts Int            @default(0)

  githubRepoUrl   String?
  githubRepoName  String?
  githubOwner     String?
  vercelProjectId String?
  liveUrl         String?

  buildStatus  String?
  buildLog     String?
  errorMessage String?

  inputTokens  Int?
  outputTokens Int?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  proposal    Proposal?        @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  deployments Deployment[]
  screenshots DemoScreenshot[]

  @@index([userId, status])
  @@index([jobId])
}

model Deployment {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  demoId String @db.ObjectId

  provider     String           @default("vercel")
  deploymentId String?
  status       DeploymentStatus @default(QUEUED)
  url          String?
  inspectorUrl String?
  target       String           @default("production")
  readyAt      DateTime?
  errorMessage String?
  logs         Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  demo DemoProject @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@index([demoId])
  @@index([userId, status])
}

model DemoScreenshot {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  demoId    String   @db.ObjectId
  label     String
  path      String
  routePath String
  width     Int
  height    Int
  viewport  String   @default("desktop")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  demo DemoProject @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@index([demoId, order])
}

model ProposalDocument {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  proposalId   String         @unique @db.ObjectId
  status       DocumentStatus @default(PENDING)
  title        String
  filePath     String?
  pageCount    Int?
  content      Json?
  errorMessage String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Portfolio
// ---------------------------------------------------------------------------

model PortfolioProject {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  title          String
  description    String
  technologies   String[]  @default([])
  url            String?
  githubUrl      String?
  clientIndustry String?
  projectType    String?
  achievements   String[]  @default([])
  highlighted    Boolean   @default(false)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, highlighted])
}

// ---------------------------------------------------------------------------
// Automation & audit
// ---------------------------------------------------------------------------

model AutomationRun {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId

  status  AutomationRunStatus @default(QUEUED)
  trigger AutomationTrigger   @default(MANUAL)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  jobsFetched        Int      @default(0)
  jobsNew            Int      @default(0)
  jobsAnalyzed       Int      @default(0)
  topJobsSelected    Int      @default(0)
  proposalsGenerated Int      @default(0)
  demosAttempted     Int      @default(0)
  demosGenerated     Int      @default(0)
  documentsGenerated Int      @default(0)
  estimatedConnects  Int      @default(0)
  inputTokens        Int      @default(0)
  outputTokens       Int      @default(0)
  errorCount         Int      @default(0)
  errorMessage       String?
  searchProfileIds   String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs      AutomationRunLog[]
  runJobs   AutomationRunJob[]
  proposals AutomationRunProposal[]

  @@index([userId, startedAt])
  @@index([status])
}

model AutomationRunLog {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  runId     String      @db.ObjectId
  level     RunLogLevel @default(INFO)
  step      String
  message   String
  data      Json?
  createdAt DateTime    @default(now())

  run AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}

model AutomationRunJob {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  runId     String   @db.ObjectId
  jobId     String   @db.ObjectId
  selected  Boolean  @default(false)
  rank      Int?
  createdAt DateTime @default(now())

  run AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  job Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([runId, jobId])
  @@index([runId, selected])
}

model AutomationRunProposal {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  runId      String   @db.ObjectId
  proposalId String   @db.ObjectId
  createdAt  DateTime @default(now())

  run      AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  proposal Proposal      @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([runId, proposalId])
}

model Submission {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  userId     String @db.ObjectId
  proposalId String @db.ObjectId
  jobId      String @db.ObjectId

  status           SubmissionStatus @default(PENDING)
  idempotencyKey   String           @unique
  connectsSpent    Int?
  connectsBefore   Int?
  connectsAfter    Int?
  upworkOfferId    String?
  upworkResponse   Json?
  /// Outcome flags, read back from the Upwork response. Stored as columns
  /// rather than queried out of JSON so reporting works on any database.
  interviewing     Boolean          @default(false)
  hired            Boolean          @default(false)
  errorMessage     String?
  approvedByUserId String?
  submittedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([proposalId])
}

model Notification {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  userId       String             @db.ObjectId
  type         NotificationType
  status       NotificationStatus @default(PENDING)
  channel      String             @default("email")
  subject      String
  body         String
  data         Json?
  sentAt       DateTime?
  readAt       DateTime?
  errorMessage String?
  createdAt    DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
}

/// Token accounting for cost protection and the admin dashboard.
model AiUsageRecord {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String?  @db.ObjectId
  operation    String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  durationMs   Int?
  success      Boolean  @default(true)
  jobId        String?
  runId        String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([operation])
  @@index([createdAt])
}

/// Security / integration audit trail. Never stores secret values.
model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?  @db.ObjectId
  action     String
  resource   String?
  resourceId String?
  success    Boolean  @default(true)
  statusCode Int?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
  @@index([createdAt])
}
